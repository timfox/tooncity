#usda 1.0
(
    "Toon City corrupt character kit — Ink Smudge (ink variant). "
    "LOD bands mirror Toon Actor 1000/500/250; pure/ink material looks; "
    "FX sockets for telegraph/hit/death/cream attach. Bake targets feed "
    "Actor-compatible BAM paths; DistributedCorruptToon CardMaker fallback "
    "stays until a future feature-flagged kit load. No Hydra."
)

