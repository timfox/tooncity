#usda 1.0
(
    "Toon City USD — Loopy Lane pure look opinion. "
    "Purity restore materials / lights; bake tables only — no Hydra."
)

def Xform "LoopyLane"
{
    def Xform "Look_Pure" (
        customData = {
            string tc:kind = "TcMaterialLook"
            string tc:look = "pure"
            string tc:tintHint = "purity"
        }
    )
    {
    }

    def Xform "Light_Pure" (
        customData = {
            string tc:kind = "TcLightLook"
            string tc:look = "pure"
            float tc:intensity = 1.0
            string tc:colorHint = "daylight"
        }
    )
    {
    }
}
