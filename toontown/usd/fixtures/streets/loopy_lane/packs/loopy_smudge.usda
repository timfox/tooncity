#usda 1.0
(
    "Toon City USD — Loopy Lane reclaim pack overlay (loopy-smudge). "
    "Matches ReclaimGlobals STREET_PACKS zone 2200 / packId loopy-smudge. "
    "Spawn stands + reclaim volume metadata; no KH branding."
)

def Xform "LoopyLane" (
    customData = {
        string tc:kind = "TcStreetRoot"
        int tc:zoneId = 2200
        string tc:hood = "TT"
        string tc:packId = "loopy-smudge"
        string tc:bamPath = "phase_5/models/neighborhoods/loopy_lane_overlay.bam"
    }
)
{
    def Xform "ReclaimVolume" (
        customData = {
            string tc:kind = "TcReclaimVolume"
            float tc:seedPollution = 0.55
        }
    )
    {
    }

    def Xform "SpawnStand_Ink" (
        customData = {
            string tc:kind = "TcSpawnStand"
            string tc:archetype = "ink"
            int tc:standIndex = 0
        }
    )
    {
    }

    def Xform "SpawnStand_Brute" (
        customData = {
            string tc:kind = "TcSpawnStand"
            string tc:archetype = "brute"
            int tc:standIndex = 1
        }
    )
    {
    }

    def Xform "SpawnStand_Snare" (
        customData = {
            string tc:kind = "TcSpawnStand"
            string tc:archetype = "snare"
            int tc:standIndex = 2
        }
    )
    {
    }

    def Xform "InkBanner" (
        customData = {
            string tc:kind = "TcProp"
            string tc:bamPath = "phase_5/models/props/loopy_ink_banner.bam"
            string tc:dnaCode = "loopy_ink_banner"
        }
    )
    {
    }
}
